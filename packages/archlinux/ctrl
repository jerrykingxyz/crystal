#!/usr/bin/env bash

set -e

. "$(dirname "${BASH_SOURCE[0]}")/../../lib/platform.sh"

init_platform_env "${BASH_SOURCE[0]}"

ACTION=${1:?}
shift

select_packages() {
    if [ "$#" -gt 0 ]; then
        echo "$*"
        return
    fi

    list_platform_packages
}

run_packages() {
    local action=$1
    local ran=0
    local status
    shift

    for pkg in "$@"; do
        if ! platform_package_exists "$pkg"; then
            echo "unknown $PLATFORM_NAME package: $pkg" >&2
            return 1
        elif ! platform_package_supports_action "$pkg" "$action"; then
            status=2
        elif [ "$action" = "profile" ]; then
            source "$PLATFORM_DIR/$pkg/ctrl" "$action"
            status=0
        elif run_platform_package "$pkg" "$action"; then
            status=0
        else
            status=$?
        fi

        if [ "$status" = "0" ]; then
            ran=1
        else
            if [ "$status" != "2" ]; then
                return "$status"
            fi
        fi
    done

    [ "$ran" = "1" ]
}

case "$ACTION" in
    config)
        pkg=${1:?}
        shift
        run_platform_package "$pkg" "$ACTION" "$@"
        ;;
    profile)
        run_packages "$ACTION" $(select_packages "$@")
        ;;
    *)
        run_packages "$ACTION" $(select_packages "$@")
        ;;
esac
