#!/usr/bin/env bash

set -e

. "$(dirname "${BASH_SOURCE[0]}")/../../lib/platform.sh"

init_platform_env "${BASH_SOURCE[0]}"

ACTION=${1:?}
shift

if [ "$ACTION" = "config" ]; then
    pkg=${1:?}
    shift
    run_platform_package "$pkg" "$ACTION" "$@"
    exit
fi

if [ "$#" -gt 0 ]; then
    pkgs="$*"
else
    pkgs=$(list_platform_packages)
fi

for pkg in $pkgs; do
    run_platform_package "$pkg" "$ACTION"
done
