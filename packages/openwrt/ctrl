#!/usr/bin/env bash

set -e

. "$(dirname "${BASH_SOURCE[0]}")/../../lib/platform.sh"

init_platform_env "${BASH_SOURCE[0]}"

DEFAULT_PACKAGES="xray nftables dhcp dns vpn apiserver"
REVERSE_PACKAGES="apiserver vpn dns dhcp nftables xray"
ACTION=${1:?}
shift

select_packages() {
    local action=$1
    shift

    if [ "$#" -gt 0 ]; then
        echo "$*"
    elif [ "$action" = "stop" ] || [ "$action" = "root_remove" ]; then
        echo "$REVERSE_PACKAGES"
    else
        echo "$DEFAULT_PACKAGES"
    fi
}

run_packages() {
    local action=$1
    local ran=0
    local status
    shift

    for pkg in "$@"; do
        if run_supported_platform_package "$pkg" "$action"; then
            ran=1
        else
            status=$?
            if [ "$status" != "2" ]; then
                return "$status"
            fi
        fi
    done

    [ "$ran" = "1" ]
}

case "$ACTION" in
    config)
        pkg=${1:?}
        shift
        run_platform_package "$pkg" "$ACTION" "$@"
        ;;
    root_setup)
        rm -f /etc/init.d/crystal
        ln -s "$PLATFORM_DIR/crystal" /etc/init.d/crystal
        run_packages "$ACTION" $(select_packages "$ACTION" "$@")
        ;;
    root_remove)
        run_packages "$ACTION" $(select_packages "$ACTION" "$@")
        rm -f /etc/init.d/crystal
        ;;
    restart)
        run_packages stop $(select_packages stop "$@")
        run_packages start $(select_packages start "$@")
        ;;
    *)
        run_packages "$ACTION" $(select_packages "$ACTION" "$@")
        ;;
esac
