#!/usr/bin/env bash

set -e
set -o pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

source "$SCRIPT_DIR/../../../lib/env.sh"
init_pkg_env "${BASH_SOURCE[0]}"
source "$ROOT_DIR/lib/config.sh"

ACTION=${1:?}
CFG_FILE="$PKG_DIR/config"

load_config() {
    domain=$(get_config_var "$CFG_FILE" domain)
    ip_url=$(get_config_var "$CFG_FILE" ip_url)
    update_command=$(get_config_var "$CFG_FILE" update_command)
    [ -n "$domain" ] && [ -n "$update_command" ] && [[ "$ip_url" == https://* ]]
}

# 更新命令负责鉴权、请求和业务响应检查，退出码为 0 才记为成功。
update_address() {
    local version=$1 record_type=$2 target local_ip ip pattern state_file="$TEMP_DIR/ipv$1"

    if [ "$version" = 4 ]; then
        target=1.1.1.1
    else
        target=2606:4700:4700::1111
    fi
    local_ip=$(ip route get "$target" 2>/dev/null |
        awk '{ for (i = 1; i < NF; i++) if ($i == "src") { print $(i + 1); exit } }') || true
    if [ -z "$local_ip" ]; then
        echo "ddns: 无法获取 IPv$version 出口接口地址，跳过 $record_type"
        return 1
    fi

    ip=$(curl -q "-$version" --interface "$local_ip" --noproxy '*' --fail --silent --show-error \
        --connect-timeout 10 --max-time 20 "$ip_url") || return 1
    if [ "$version" = 4 ]; then
        pattern='^([0-9]{1,3}\.){3}[0-9]{1,3}$'
    else
        pattern='^[0-9a-fA-F]*:[0-9a-fA-F:]*$'
    fi
    if [[ ! "$ip" =~ $pattern ]]; then
        echo "ddns: ip_url 未返回 IPv$version 地址" >&2
        return 1
    fi
    if [ "$local_ip" != "$ip" ]; then
        echo "ddns: 本机出口地址 $local_ip 与公网探测地址 $ip 不一致，跳过 $record_type（可能存在上级 NAT）"
        return 1
    fi
    if [ -f "$state_file" ] && [ "$(cat "$state_file")" = "$domain $ip" ]; then
        return 0
    fi

    DOMAIN="$domain" IP="$ip" IP_VERSION="ipv$version" RECORD_TYPE="$record_type" \
        DDNS_DIR="$PKG_DIR" bash -e -o pipefail -c "$update_command" || return 1
    printf '%s\n' "$domain $ip" > "$state_file" || return 1
    echo "ddns: $domain 的 $record_type 记录已更新为 $ip"
}

# 读出现有任务，删除本包旧任务，按需追加一行，再整体写回。
write_crontab() {
    {
        (crontab -l 2>/dev/null || true) | sed '/ # crystal-ddns$/d'
        if [ "$1" = start ]; then
            printf '*/5 * * * * /bin/bash "%s/ctrl" update 2>&1 | logger -t crystal-ddns # crystal-ddns\n' \
                "$PKG_DIR"
        fi
    } | crontab -
}

case "$ACTION" in
    root_setup)
        opkg update
        opkg install curl
        /etc/init.d/cron enable
        ;;
    start)
        [ -f "$CFG_FILE" ] || exit 0
        load_config
        mkdir -p "$TEMP_DIR"
        rm -f "$TEMP_DIR/ipv4" "$TEMP_DIR/ipv6"
        write_crontab start
        /etc/init.d/cron start
        "$0" update || logger -t crystal-ddns '首次更新失败，等待定时重试'
        ;;
    stop|root_remove)
        write_crontab stop
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    update)
        load_config
        mkdir -p "$TEMP_DIR"
        status=0
        update_address 4 A || status=1
        update_address 6 AAAA || status=1
        exit "$status"
        ;;
    config)
        umask 077
        update_config_var "$CFG_FILE" "${2:?}" "${3-}"
        chmod 600 "$CFG_FILE"
        ;;
    *)
        echo "package $PKG_NAME ignore action $ACTION"
        ;;
esac
