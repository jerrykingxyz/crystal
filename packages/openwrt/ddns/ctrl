#!/usr/bin/env bash

set -e
set -o pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

source "$SCRIPT_DIR/../../../lib/env.sh"
init_pkg_env "${BASH_SOURCE[0]}"
source "$ROOT_DIR/lib/config.sh"

ACTION=${1:?}
CFG_FILE="$PKG_DIR/config"
STATE_FILE="$TEMP_DIR/ipv6"

# 取接口上稳定的全局 IPv6：排除 DHCPv6 的 dynamic 地址、临时地址和已弃用地址。
get_ipv6() {
    ip -6 addr show dev "$1" scope global 2>/dev/null | awk '
$1 == "inet6" && !/dynamic|temporary|deprecated/ { sub(/\/.*/, "", $2); print $2; exit }'
}

# provider 只接收参数：<fqdn> <ip> [--ttl N]，API Key 走标准输入，退出码 0 才记为成功。
update() {
    local domain interface provider api_key ttl ip args
    domain=$(get_config_var "$CFG_FILE" domain)
    provider=$(get_config_var "$CFG_FILE" provider)
    api_key=$(get_config_var "$CFG_FILE" api_key)
    interface=$(get_config_var "$CFG_FILE" interface || true)
    ttl=$(get_config_var "$CFG_FILE" ttl || true)
    [ -n "$domain" ] && [ -f "$PKG_DIR/providers/$provider" ]

    ip=$(get_ipv6 "${interface:-wan}")
    if [ -z "$ip" ]; then
        echo "ddns: ${interface:-wan} 没有可用的全局 IPv6，跳过"
        return 0
    fi
    if [ "$(cat "$STATE_FILE" 2>/dev/null || true)" = "$domain $ip" ]; then
        return 0
    fi

    args=("$domain" "$ip" --type AAAA)
    [ -z "$ttl" ] || args+=(--ttl "$ttl")
    printf '%s\n' "$api_key" | bash "$PKG_DIR/providers/$provider" "${args[@]}"
    mkdir -p "$TEMP_DIR"
    echo "$domain $ip" > "$STATE_FILE"
    echo "ddns: $domain 的 AAAA 记录已更新为 $ip"
}

# 读出现有任务，删除本包旧任务，按需追加一行，再整体写回。
write_crontab() {
    {
        (crontab -l 2>/dev/null || true) | sed '/ # crystal-ddns$/d'
        if [ "$1" = start ]; then
            printf '*/30 * * * * /bin/bash "%s/ctrl" update 2>&1 | logger -t crystal-ddns # crystal-ddns\n' \
                "$PKG_DIR"
        fi
    } | crontab -
}

case "$ACTION" in
    root_setup)
        opkg update
        opkg install curl
        /etc/init.d/cron enable
        ;;
    start)
        [ -f "$CFG_FILE" ] || exit 0
        rm -f "$STATE_FILE"
        write_crontab start
        /etc/init.d/cron start
        update || logger -t crystal-ddns '首次更新失败，等待定时重试'
        ;;
    stop|root_remove)
        write_crontab stop
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    update)
        update
        ;;
    config)
        umask 077
        update_config_var "$CFG_FILE" "${2:?}" "${3-}"
        chmod 600 "$CFG_FILE"
        ;;
    *)
        echo "package $PKG_NAME ignore action $ACTION"
        ;;
esac
