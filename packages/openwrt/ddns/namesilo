#!/usr/bin/env bash

set -e
set -o pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$SCRIPT_DIR/../../../lib/env.sh"
init_pkg_env "${BASH_SOURCE[0]}"
source "$ROOT_DIR/lib/config.sh"

api_key=$(get_config_var "$PKG_DIR/config" api_key)
ttl=$(get_config_var "$PKG_DIR/config" ttl || true)
ttl=${ttl:-3600}

if [ -z "$api_key" ] || [[ ! "$ttl" =~ ^[0-9]+$ ]] ||
    [ "$ttl" -lt 3600 ] || [ "$ttl" -gt 2592000 ]; then
    echo 'ddns: 请配置 NameSilo api_key 和有效的 ttl（最小 3600）' >&2
    exit 1
fi

# 当前使用一级子域名：home.example.com 拆成 home 和 example.com。
domain=${DOMAIN:?}
host=${domain%%.*}
zone=${domain#*.}
if [ "$host" = "$zone" ] || [[ "$zone" != *.* ]]; then
    echo 'ddns: NameSilo 更新脚本需要完整的一级子域名' >&2
    exit 1
fi
case "${RECORD_TYPE:?}" in
    A|AAAA) ;;
    *) exit 1 ;;
esac
: "${IP:?}"

umask 077
mkdir -p "$TEMP_DIR"
key_file=$(mktemp "$TEMP_DIR/api-key.XXXXXX")
trap 'rm -f "$key_file"' EXIT
trap 'exit 1' HUP INT TERM
printf '%s' "$api_key" > "$key_file"

# HTTP 成功不代表业务成功；Key 通过文件传递，不写入进程参数。
request() {
    local operation=$1 response code
    shift
    response=$(curl -q --noproxy '*' --fail --silent --show-error \
        --connect-timeout 10 --max-time 20 --get \
        --data-urlencode version=1 --data-urlencode type=xml \
        --data-urlencode "key@$key_file" --data-urlencode "domain=$zone" \
        "$@" "https://www.namesilo.com/api/$operation") || return 1
    response=$(printf '%s' "$response" | tr -d '\r\n')
    code=$(printf '%s\n' "$response" | sed -n 's/.*<code>[[:space:]]*\([0-9][0-9]*\)[[:space:]]*<\/code>.*/\1/p')
    if [ "$code" != 300 ]; then
        echo "ddns: NameSilo $operation 失败，请检查 API Key、IP 限制和域名权限" >&2
        return 1
    fi
    printf '%s\n' "$response"
}

# 每次更新前重新查询 ID，更新后旧 ID 即失效。
response=$(request dnsListRecords)
record_id=$(printf '%s\n' "$response" | awk -v host="$domain" -v type="$RECORD_TYPE" '
BEGIN { RS="</resource_record>"; FS="[<>]" }
{
    id=record_host=record_type=""
    for (i=1; i<NF; i++) {
        value=$(i+1)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
        if ($i=="record_id") id=value
        if ($i=="host") record_host=value
        if ($i=="type") record_type=value
    }
    if (record_host==host && record_type==type && id!="") print id
}')
case "$record_id" in
    '')
        echo "ddns: 请先在 NameSilo 创建 $domain 的 $RECORD_TYPE 记录" >&2
        exit 1
        ;;
    *$'\n'*)
        echo "ddns: $domain 存在多条 $RECORD_TYPE 记录，请先保留一条" >&2
        exit 1
        ;;
esac

request dnsUpdateRecord \
    --data-urlencode "rrid=$record_id" --data-urlencode "rrhost=$host" \
    --data-urlencode "rrvalue=$IP" --data-urlencode "rrttl=$ttl" > /dev/null
