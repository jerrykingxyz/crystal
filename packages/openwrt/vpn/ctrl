#!/usr/bin/env bash

set -e

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

source "$SCRIPT_DIR/../../../lib/env.sh"
init_pkg_env "${BASH_SOURCE[0]}"
source "$ROOT_DIR/lib/config.sh"
source "$ROOT_DIR/lib/render.sh"

ACTION=${1:?}
CFG_FILE="$PKG_DIR/config"
TEMPLATE_FILE="$PKG_DIR/template.json"
OUTPUT_CFG_FILE="$TEMP_DIR/config.json"
FIREWALL_RULE=crystal_vpn
SHARE_PORT=8001

# 只放行 WAN 入站 IPv6 的代理端口；先删后加，重复执行只保留一条。
open_firewall() {
    local port
    port=$(get_config_var "$CFG_FILE" port)
    uci -q delete "firewall.$FIREWALL_RULE" || true
    uci set "firewall.$FIREWALL_RULE=rule"
    uci set "firewall.$FIREWALL_RULE.name=crystal-vpn"
    uci set "firewall.$FIREWALL_RULE.src=wan"
    uci set "firewall.$FIREWALL_RULE.family=ipv6"
    uci set "firewall.$FIREWALL_RULE.proto=tcp"
    uci set "firewall.$FIREWALL_RULE.dest_port=$port"
    uci set "firewall.$FIREWALL_RULE.target=ACCEPT"
    uci commit firewall
    /etc/init.d/firewall reload
}

close_firewall() {
    if uci -q get "firewall.$FIREWALL_RULE" > /dev/null; then
        uci delete "firewall.$FIREWALL_RULE"
        uci commit firewall
        /etc/init.d/firewall reload
    fi
}

case "$ACTION" in
    root_setup)
        opkg update
        opkg install xray-core
        /etc/init.d/xray disable
        ;;
    user_setup)
        keys=$(xray x25519)
        private_key=
        public_key=

        # 按行匹配 key，再从冒号后取值，兼容 Xray 字段名变化。
        while IFS= read -r item; do
            key=$(printf '%s\n' "${item%%:*}" | sed 'y/ABCDEFGHIJKLMNOPQRSTUVWXYZ/abcdefghijklmnopqrstuvwxyz/')
            value=$(printf '%s\n' "${item#*:}" | sed 's/^[[:space:]]*//')

            case "$key" in
                *private*)
                    private_key=$value
                    ;;
                *public*)
                    public_key=$value
                    ;;
            esac
        done <<EOF
$keys
EOF

        if [ -z "$private_key" ] || [ -z "$public_key" ]; then
            false
        fi

        update_config_var "$CFG_FILE" "private_key" "$private_key"
        update_config_var "$CFG_FILE" "public_key" "$public_key"
        update_config_var "$CFG_FILE" "share_token" "$(LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32)"
        ;;
    start)
        mkdir -p "$TEMP_DIR"
        render_config "$TEMPLATE_FILE" "$CFG_FILE" > "$OUTPUT_CFG_FILE"
        xray run -c "$OUTPUT_CFG_FILE" &
        open_firewall
        ;;
    stop)
        pids=$(pgrep -f "$OUTPUT_CFG_FILE" 2>/dev/null || true)
        if [ -n "$pids" ]; then
            kill $pids || true
        fi
        close_firewall
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    share)
        token=$(get_config_var "$CFG_FILE" share_token || true)
        if [ -z "$token" ] || [ "$token" = __add_when_setup__ ]; then
            token=$(LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32)
            update_config_var "$CFG_FILE" share_token "$token"
        fi
        server_ip=$(ip -4 addr show dev br-lan | awk '$1 == "inet" { sub(/\/.*/, "", $2); print $2; exit }')
        [ -n "$server_ip" ]

        port=$(get_config_var "$CFG_FILE" port)
        vpn_domain=$(get_config_var "$CFG_FILE" vpn_domain)
        [ -n "$vpn_domain" ]
        user_id=$(get_config_var "$CFG_FILE" user_id)
        domain=$(get_config_var "$CFG_FILE" domain)
        public_key=$(get_config_var "$CFG_FILE" public_key)
        vless_url="vless://$user_id@$vpn_domain:$port?encryption=none&security=reality&type=tcp&flow=xtls-rprx-vision&sni=$domain&fp=chrome&pbk=$public_key&sid=#openwrt-vpn"

        share_dir="$TEMP_DIR/vpn_share"
        rm -rf "$share_dir"
        mkdir -p "$share_dir"
        trap 'rm -rf "$share_dir"' EXIT
        printf '%s\n' "$vless_url" | base64 | tr -d '\n' > "$share_dir/$token.txt"
        printf '%s\n' "http://$server_ip:$SHARE_PORT/$token.txt"
        uhttpd -f -D -p "0.0.0.0:$SHARE_PORT" -h "$share_dir"
        ;;
    config)
        update_config_var "$CFG_FILE" "${2:?}" "${3:?}"
        ;;
    root_remove)
        close_firewall
        opkg remove xray-core || true
        ;;
    *)
        false
        ;;
esac
